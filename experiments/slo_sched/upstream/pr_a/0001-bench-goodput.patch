             result["cache_report"] = {
                 "total_prompt_tokens": total_prompt_tokens,
@@ -2019,6 +2035,9 @@ def run_benchmark(args_: argparse.Namespace):
     if not hasattr(args, "cache_report"):
         args.cache_report = False
 
+    if not hasattr(args, "goodput"):
