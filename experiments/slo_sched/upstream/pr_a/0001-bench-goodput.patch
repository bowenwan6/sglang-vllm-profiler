new file mode 100644
index 0000000000..806f06b32a
--- /dev/null
+++ b/python/sglang/benchmark/goodput.py
@@ -0,0 +1,118 @@
+"""Goodput for the serving benchmark: the load that met its latency SLOs.
+
+A request is good if it succeeded and met every given SLO, so a failed request
+counts as a miss. The serving benchmark issues the requests and reports its
+full-run metrics; this module only parses the SLOs and scores the results.
+"""
+
+import math
+from typing import Dict, List, Optional, Protocol, Sequence
+
+import msgspec
+
+GOODPUT_SLO_METRICS = ("ttft", "tpot", "e2el")
+
+
+class RequestOutput(Protocol):
+    """The subset of a serving request result needed by this module."""
+
+    success: bool
+    latency: float
+    ttft: float
+    output_len: int
+
+
+class GoodputReport(msgspec.Struct, frozen=True):
+    """Field names are the keys written to the benchmark result file."""
+
+    goodput_slos_ms: Dict[str, float]
+    # Good requests per second of benchmark duration.
+    request_goodput: float
+    # Good requests over requests sent: for all SLOs together, then for each alone.
+    slo_attainment: float
+    slo_attainment_by_metric: Dict[str, float]
+
+
+def parse_goodput_slos(slo_pairs: Optional[List[str]]) -> Optional[Dict[str, float]]:
+    """Parse --goodput KEY:VALUE pairs into {metric: SLO in milliseconds}."""
+    if not slo_pairs:
+        return None
+    slos: Dict[str, float] = {}
+    for pair in slo_pairs:
+        name, sep, value = pair.partition(":")
+        if not sep or name not in GOODPUT_SLO_METRICS:
+            raise ValueError(
+                f"Invalid --goodput entry {pair!r}: expected KEY:VALUE with KEY in "
+                f"{', '.join(GOODPUT_SLO_METRICS)}."
+            )
+        if name in slos:
+            raise ValueError(f"Duplicate --goodput metric {name!r}.")
+        try:
+            slo_ms = float(value)
+        except ValueError:
+            raise ValueError(
+                f"Invalid --goodput value in {pair!r}: expected milliseconds."
+            ) from None
+        if not math.isfinite(slo_ms) or slo_ms <= 0:
+            raise ValueError(
+                f"Invalid --goodput value in {pair!r}: must be a positive number."
+            )
+        slos[name] = slo_ms
+    return slos
+
+
+def _request_slo_results(
+    output: RequestOutput, goodput_slos: Dict[str, float]
+) -> Dict[str, bool]:
+    if not output.success:
+        return {name: False for name in goodput_slos}
+    # A single-token response has no inter-token interval, so its TPOT is 0.
+    tpot_s = (
+        (output.latency - output.ttft) / (output.output_len - 1)
+        if output.output_len > 1
+        else 0.0
+    )
+    observed_ms = {
+        "ttft": output.ttft * 1000,
+        "tpot": tpot_s * 1000,
+        "e2el": output.latency * 1000,
+    }
+    return {name: observed_ms[name] <= slo for name, slo in goodput_slos.items()}
+
+
+def calculate_goodput(
+    outputs: Sequence[RequestOutput], goodput_slos: Dict[str, float], dur_s: float
+) -> GoodputReport:
+    slo_results = [
+        _request_slo_results(output=output, goodput_slos=goodput_slos)
+        for output in outputs
+    ]
+    num_requests = max(len(outputs), 1)
+    num_good = sum(all(result.values()) for result in slo_results)
+    return GoodputReport(
+        goodput_slos_ms=goodput_slos,
+        request_goodput=num_good / dur_s,
+        slo_attainment=num_good / num_requests,
+        slo_attainment_by_metric={
+            name: sum(result[name] for result in slo_results) / num_requests
+            for name in goodput_slos
+        },
+    )
+
+
+def print_goodput(report: GoodputReport) -> None:
+    print("{s:{c}^{n}}".format(s="Goodput", n=50, c="-"))
+    print(
+        "{:<40} {:<10}".format(
+            "SLOs (ms):",
+            " ".join(f"{name}:{slo:g}" for name, slo in report.goodput_slos_ms.items()),
+        )
+    )
+    print("{:<40} {:<10.2f}".format("Request goodput (req/s):", report.request_goodput))
+    print("{:<40} {:<10.2f}".format("SLO attainment (%):", report.slo_attainment * 100))
+    for name, attainment in report.slo_attainment_by_metric.items():
+        print(
+            "{:<40} {:<10.2f}".format(
+                f"{name.upper()} SLO attainment (%):", attainment * 100
+            )
+        )
