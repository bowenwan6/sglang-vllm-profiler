diff --git a/test/registered/unit/bench/test_bench_serving_goodput.py b/test/registered/unit/bench/test_bench_serving_goodput.py
new file mode 100644
index 0000000000..0ac5940afe
--- /dev/null
+++ b/test/registered/unit/bench/test_bench_serving_goodput.py
@@ -0,0 +1,72 @@
+"""Unit tests for the goodput bench_serving reports under --goodput."""
+
+import unittest
+
+from sglang.benchmark.goodput import calculate_goodput, parse_goodput_slos
+from sglang.benchmark.serving import RequestFuncOutput
+from sglang.test.ci.ci_register import register_cpu_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_cpu_ci(est_time=5, suite="base-a-test-cpu")
+
+DURATION_S = 10.0
+
+
+def _output(ttft, latency, output_len, success=True):
+    return RequestFuncOutput(
+        success=success, ttft=ttft, latency=latency, output_len=output_len
+    )
+
+
+# ttft / tpot / e2el in ms: 100 / 100 / 900, 500 / 100 / 900, 200 / 200 / 2200,
+# 200 / 0 / 200 (a single token), then one failed request.
+OUTPUTS = [
+    _output(ttft=0.1, latency=0.9, output_len=9),
+    _output(ttft=0.5, latency=0.9, output_len=5),
+    _output(ttft=0.2, latency=2.2, output_len=11),
+    _output(ttft=0.2, latency=0.2, output_len=1),
+    _output(ttft=0.0, latency=0.0, output_len=0, success=False),
+]
+
+
+class TestBenchServingGoodput(CustomTestCase):
+    def test_request_is_good_only_if_it_meets_every_listed_slo(self):
+        all_three = {"ttft": 3 / 5, "tpot": 3 / 5, "e2el": 3 / 5}
+        # (--goodput entries, good requests, attainment of each listed SLO alone)
+        cases = [
+            (["ttft:300", "tpot:150", "e2el:1000"], 2, all_three),
+            (["ttft:300"], 3, {"ttft": 3 / 5}),
+            # 95.5 ms separates the true 100 ms TPOT from the 88.9 ms that dividing
+            # by output_len would give.
+            (["tpot:95.5"], 1, {"tpot": 1 / 5}),
+        ]
+        for entries, num_good, by_metric in cases:
+            with self.subTest(entries=entries):
+                report = calculate_goodput(
+                    outputs=OUTPUTS,
+                    goodput_slos=parse_goodput_slos(entries),
+                    dur_s=DURATION_S,
+                )
+                self.assertEqual(report.request_goodput, num_good / DURATION_S)
+                self.assertEqual(report.slo_attainment, num_good / len(OUTPUTS))
+                self.assertEqual(report.slo_attainment_by_metric, by_metric)
+
+    def test_invalid_slo_entries_are_rejected(self):
+        cases = [
+            ["itl:10"],
+            ["ttft:fast"],
+            ["ttft:0"],
+            ["ttft:inf"],
+            ["ttft:100", "ttft:200"],
+        ]
+        for entries in cases:
+            with self.subTest(entries=entries):
+                with self.assertRaises(ValueError):
+                    parse_goodput_slos(entries)
+
+    def test_no_slos_without_the_flag(self):
+        self.assertIsNone(parse_goodput_slos(None))
+
+
+if __name__ == "__main__":
+    unittest.main()
